# Gitignore-style defaults for PII Radar.
# Review these exclusions for each data set; ignored content is not scanned.

# Version control
.git/
.hg/
.svn/

# Dependencies and virtual environments
node_modules/
vendor/
venv/
.venv/
__pycache__/

# Build output
target/
dist/
build/
*.o
*.so
*.dylib
*.dll
*.exe
*.class
*.pyc

# Editors and temporary files
.idea/
.vscode/
*.swp
*.swo
*.tmp
*.temp
*.bak
*~

# Media and archives are normally unsuitable for direct text scanning.
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.svg
*.mp3
*.mp4
*.avi
*.mov
*.wav
*.zip
*.tar
*.gz
*.7z
*.rar

# Operating-system metadata
.DS_Store
Thumbs.db
